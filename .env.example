# Neon PostgreSQL pooled URL for application/runtime connections.
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon PostgreSQL direct URL for Prisma migrations and administrative commands.
DIRECT_URL="postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/DB?sslmode=require"

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
